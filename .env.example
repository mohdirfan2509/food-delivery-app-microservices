# ==============================================================================
# Food Delivery Microservices - Environment Variables Example
# Copy this file to .env and adjust variables for your local/Docker environment.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Docker Infrastructure Host Ports (Mapped on Ubuntu Host to Avoid Conflicts)
# ------------------------------------------------------------------------------
# Local host port mappings for Docker containers
MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=root

REDIS_HOST_PORT=6380

KAFKA_HOST_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ------------------------------------------------------------------------------
# Docker Internal Service Hostnames & Ports (For Inter-Container Networking)
# ------------------------------------------------------------------------------
MYSQL_DOCKER_HOST=mysql
MYSQL_DOCKER_PORT=3306

REDIS_DOCKER_HOST=redis
REDIS_DOCKER_PORT=6379

KAFKA_DOCKER_BOOTSTRAP_SERVERS=kafka:9092

# ------------------------------------------------------------------------------
# Config Server & Repository (External Git Repository)
# ------------------------------------------------------------------------------
CONFIG_SERVER_PORT=8888
CONFIG_REPO_GIT_URI=https://github.com/mohdirfan2509/config-repo.git
CONFIG_REPO_BRANCH=main
# Optional credentials if config-repo is private:
# CONFIG_REPO_USERNAME=
# CONFIG_REPO_PASSWORD=

# ------------------------------------------------------------------------------
# Service Ports (Local IntelliJ Development)
# ------------------------------------------------------------------------------
GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
FOOD_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
PAYMENT_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085

# ------------------------------------------------------------------------------
# Database Configurations (Local IntelliJ connecting to Docker MySQL on 3307)
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3307

USER_DB_URL=jdbc:mysql://localhost:3307/userdb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
USER_DB_USERNAME=root
USER_DB_PASSWORD=root

FOOD_DB_URL=jdbc:mysql://localhost:3307/fooddb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
FOOD_DB_USERNAME=root
FOOD_DB_PASSWORD=root

ORDER_DB_URL=jdbc:mysql://localhost:3307/orderdb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
ORDER_DB_USERNAME=root
ORDER_DB_PASSWORD=root

PAYMENT_DB_URL=jdbc:mysql://localhost:3307/paymentdb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
PAYMENT_DB_USERNAME=root
PAYMENT_DB_PASSWORD=root

NOTIFICATION_DB_URL=jdbc:mysql://localhost:3307/notificationdb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
NOTIFICATION_DB_USERNAME=root
NOTIFICATION_DB_PASSWORD=root

# ------------------------------------------------------------------------------
# Redis Cache Configuration (Local IntelliJ connecting to Docker Redis on 6380)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_CACHE_TTL=3600000

# ------------------------------------------------------------------------------
# Apache Kafka Broker Configuration
# ------------------------------------------------------------------------------
KAFKA_CONSUMER_GROUP=notification-service-group
KAFKA_TOPIC_ORDER_CREATED=order-created

# ------------------------------------------------------------------------------
# Inter-Service Declarative REST URLs (Local IntelliJ Development)
# ------------------------------------------------------------------------------
USER_SERVICE_URL=http://localhost:8081
FOOD_SERVICE_URL=http://localhost:8082
ORDER_SERVICE_URL=http://localhost:8083
PAYMENT_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085

# ------------------------------------------------------------------------------
# Security & JWT Token Configuration
# ------------------------------------------------------------------------------
# HS256 requires at least a 256-bit (32-byte) hex-encoded secret key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
